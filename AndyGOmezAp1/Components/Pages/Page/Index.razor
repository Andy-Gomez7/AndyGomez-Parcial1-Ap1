@page "/Autor/Index"
@using AndyGOmezAp1.Models;
@using AndyGOmezAp1.Services;
@using Microsoft.AspNetCore.Components.QuickGrid
@using static Microsoft.AspNetCore.Components.Web.RenderMode;
@inject AutorService autorService;
@inject NavigationManager Navegacion;
@rendermode InteractiveServer

<PageTitle>Titulo</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center" style="height: 54px;">
            <h5 class="mb-0">Indice Autores</h5>
            <a class="btn btn-primary" href="/Autor/Create">Crear</a>
        </div>

        <div class="card-body">
            <div class="row">

                @*Labels*@
                <div class="col-3">
                    <label class="form-label" for="Filtro"><strong>Filtrar por</strong></label>
                </div>

                <div class="col-4">
                    <label class="form-label" for="ValorFiltro"><strong>Buscar</strong></label>
                </div>
            </div>

            <div class="row">
                <div class="col-3">
                    <select class="form-select" @bind="Filtro">
                            <option value="Nombre" selected disable >Seleccione</option>
                            <option value="Nacionalidad"></option>
                    </select>
                </div>

                @*Tabla*@
                <div>
                    <QuickGrid Items="@listaAutores.AsQueryable()">
                        <PropertyColumn Property="@(A => A.Nombres)" Title ="Nombre" Sortable="true"/>
                        <PropertyColumn Property="@(A => A.Nacionalidad)" Title ="Nombre" Sortable="true"/>
                        <PropertyColumn Property="@(A => A.FechaNacimiento)" Title ="Nombre" Sortable="true"/>
                        <PropertyColumn Property="@(A => A.Sueldo)" Title ="Nombre" Sortable="true"/>
                    </QuickGrid>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control"@bind-value="ValorFiltro" placeholder="Buscar"/>
                        <button type="form-label"class="btn btn-outline-primary"@onclick="">Buscar</button>
                    </div>
                </div>

                @*Reestablecer*@
                <div class="col-auto">
                    <button type="button"class="btn btn-outline-secondary"@onclick="">Reestablcer</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code{
    public List<Autor> listaAutores {get; set;} = new List<Autor>();
    public String? Filtro {get; set;}
    public String? ValorFiltro {get; set;}

    protected override async void OnInitialized()
    {
        listaAutores = await autorService.GetList(A => A.AutorId > 0);
    }

    public async Task Buscar()
    {
        if (Filtro.Trim() != "")
        {
            if (Filtro == "Nombre")
            {
                listaAutores = await autorService.GetList(A => A.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Nacionalidad")
            {
                listaAutores = await autorService.GetList(A => A.Nacionalidad.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
    }

    public async Task Reestablecer()
    {
        listaAutores = await autorService.GetList(A => A.AutorId > 0);
        Filtro = String.Empty;
        ValorFiltro = String.Empty;
    }
}