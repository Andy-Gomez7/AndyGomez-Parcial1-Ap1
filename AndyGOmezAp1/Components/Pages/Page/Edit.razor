@page "/Autor/Edit"
@using AndyGOmezAp1.Models;
@using AndyGOmezAp1.Services;
@using static Microsoft.AspNetCore.Components.Web.RenderMode;
@inject AutorService autorService;
@inject NavigationManager Navegacion;
@rendermode InteractiveServer

<PageTitle>Editar Estudiante</PageTitle>
<EditForm Model="Autor" OnValidSubmit="Modificar"></EditForm>
<DataAnnotationsValidator/>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-hoader text-center">
            <h5 class="card-title"><strong>Modificar Autor</strong></h5>
        </div>



        
    </div>
</div>

@code{
    public String Mensaje { get; set; } = String.Empty;
    public Autor Autor { get; set; } = new Autor();

    public async Task Modificar()
    {
        var existe = await autorService.Existe(Autor.Nombres);
        if (existe)
        {
            var modificado = await autorService.Modificar(Autor);
            if (modificado)
            {
                Mensaje = "El autor fue modificado";
                Navegacion.NavigateTo("/Autor/Index");
                return;
            }
            else
            {
                Mensaje = "El autor no fue modificado exitosamente";
                return;
            }   
        }
    }

    public async Task Eliminar()
    {
        var existe = await autorService.Existe(Autor.Nombres);
        if (existe)
        {
            var eliminado = await autorService.Eliminar(Autor.AutorId);
            if (eliminado)
            {
                Mensaje = "El autor fue modificado";
                Navegacion.NavigateTo("/Autor/Index");
                return;
            }
            else
            {
                Mensaje = "El autor fue modificado";
                Navegacion.NavigateTo("/Autor/Index");
            }   
        }
    }
}